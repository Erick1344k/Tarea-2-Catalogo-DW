        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario.a@ejemplo.local\",\n  \"password\": \"incorrecta\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Credenciales 401', () => pm.response.to.have.status(401));"] } }]
