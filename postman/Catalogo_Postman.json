        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Inválido\",\n  \"descripcion\": \"Precio incorrecto\",\n  \"categoria\": \"Pruebas\",\n  \"precio\": 0\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Precio inválido 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
