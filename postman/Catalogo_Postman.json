          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/productos/{{productId}}",
        "body": { "mode": "raw", "raw": "{ \"precio\": 150000 }" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizar 200', () => pm.response.to.have.status(200));"] } }]
