      "request": { "method": "GET", "url": "{{baseUrl}}/productos?categoria=Tecnología" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Filtro 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
