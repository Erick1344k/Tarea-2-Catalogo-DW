      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/productos",
        "body": { "mode": "raw", "raw": "{ \"nombre\": \"\", \"descripcion\": \"\", \"categoria\": \"\", \"precio\": 10 }" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Vacíos 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
