      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario.b@ejemplo.local\",\n  \"password\": \"Prueba123!\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login B 200', () => pm.response.to.have.status(200));",
        "pm.environment.set('tokenB', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "06 Login incorrecto",
      "request": {
        "method": "POST",
