      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenA}}" }
        ],
        "url": "{{baseUrl}}/favoritos",
        "body": { "mode": "raw", "raw": "{ \"productoId\": {{productId}} }" }
