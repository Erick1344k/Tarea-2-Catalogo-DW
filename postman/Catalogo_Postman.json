      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/productos",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto Postman\",\n  \"descripcion\": \"Producto de prueba creado en la colección\",\n  \"categoria\": \"Pruebas\",\n  \"precio\": 125000\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Crear 201', () => pm.response.to.have.status(201));",
        "pm.environment.set('productId', pm.response.json().id);"
      ] } }]
    },
    {
