      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Admin login 200', () => pm.response.to.have.status(200));",
        "pm.environment.set('adminToken', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "08 Listar productos público",
      "request": { "method": "GET", "url": "{{baseUrl}}/productos" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Catálogo 200', () => pm.response.to.have.status(200));",
        "pm.test('Es arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ] } }]
    },
    {
