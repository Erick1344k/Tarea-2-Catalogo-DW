{
  "info": {
    "name": "Catálogo API - Pruebas obligatorias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Registro usuario A",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/registro",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario A\",\n  \"email\": \"usuario.a@ejemplo.local\",\n  \"password\": \"Prueba123!\",\n  \"rol\": \"administrador\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Registro 201', () => pm.response.to.have.status(201));",
        "const data = pm.response.json();",
        "pm.test('No expone hash', () => pm.expect(JSON.stringify(data)).to.not.include('password_hash'));"
      ] } }]
    },
    {
      "name": "02 Registro duplicado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/registro",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario Duplicado\",\n  \"email\": \"usuario.a@ejemplo.local\",\n  \"password\": \"Prueba123!\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Duplicado 409', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "03 Login usuario A",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario.a@ejemplo.local\",\n  \"password\": \"Prueba123!\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.environment.set('tokenA', data.token);"
      ] } }]
    },
    {
      "name": "04 Registro usuario B",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/registro",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario B\",\n  \"email\": \"usuario.b@ejemplo.local\",\n  \"password\": \"Prueba123!\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Registro B 201', () => pm.response.to.have.status(201));"] } }]
